// SANOMIN International Preschool — Student Management System
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider      = "sqlite"
  url           = env("DATABASE_URL")
  // Polymorphic personId on Attendance backs BOTH the `student` and `teacher`
  // relations — SQLite can't enforce two FKs on one column. Defer referential
  // integrity to the Prisma Client so inserts work for either person type.
  relationMode  = "prisma"
}

// ─── Programs (Preschool, Daycare, IT, Elocution, Dancing) ───────────────
model Program {
  id          String   @id @default(cuid())
  code        String   @unique            // "PRESCHOOL", "DAYCARE", "IT"...
  name        String
  description String?
  color       String   @default("#7c3aed")
  monthlyFee  Float    @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  classes     Class[]
  payments    Payment[]
  paymentItems PaymentItem[]
}

// ─── Students ─────────────────────────────────────────────────────────────
model Student {
  id             String   @id @default(cuid())
  studentId      String   @unique           // "P24001"
  indexNo        String?                    // "200"
  barcode        String   @unique           // barcode value for scanner
  fullName       String
  gender         String                     // Male | Female
  dob            DateTime?
  ageGroup       String?                    // "2-3"
  admissionDate  DateTime?
  religion       String?
  nationality    String?
  previousSchool String?
  photoUrl       String?
  status         String   @default("Active") // Active | Inactive | Graduated
  medicalNotes   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guardians      Guardian[]
  enrollments    Enrollment[]
  attendance     Attendance[]
  payments       Payment[]
}

// ─── Guardians (parents) ──────────────────────────────────────────────────
model Guardian {
  id          String   @id @default(cuid())
  studentId   String
  name        String
  phone       String
  address     String?
  email       String?
  relationship String  @default("Guardian")
  occupation  String?
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ─── Teachers (Internal & External) ───────────────────────────────────────
model Teacher {
  id             String   @id @default(cuid())
  teacherId      String   @unique            // "T001"
  fingerprintId  String?  @unique            // fingerprint template id for scanner
  fullName       String
  type           String   @default("Internal") // Internal | External
  gender         String?
  phone          String?
  email          String?
  address        String?
  nic            String?                      // national ID
  qualification  String?
  specialization String?                      // subjects e.g. "Elocution,IT"
  photoUrl       String?
  status         String   @default("Active")  // Active | Inactive | On Leave
  hireDate       DateTime?
  monthlyRate    Float    @default(0)          // for external tuition teachers
  // ── Salary & statutory contributions (Sri Lanka) ──
  basicSalary    Float    @default(0)          // monthly basic salary
  allowances     Float    @default(0)          // monthly allowances (transport, etc.)
  epfNo          String?                      // EPF beneficiary number
  salaryNote     String?                      // salary remarks / bank details
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classes        Class[]
  attendance     Attendance[]
  payrollRecords PayrollRecord[]
}

// ─── Payroll (monthly salary register for teachers) ────────────────────
// One row per teacher per month. Amounts are SNAPSHOTTED when the salary is
// marked paid so later edits to the teacher's salary don't rewrite history.
model PayrollRecord {
  id           String    @id @default(cuid())
  teacherId    String
  month        String                       // "YYYY-MM" the salary is FOR
  basicSalary  Float     @default(0)
  allowances   Float     @default(0)
  gross        Float     @default(0)        // basic + allowances
  epfEmployee  Float     @default(0)        // 8% of basic (deducted from staff)
  netSalary    Float     @default(0)        // gross − epfEmployee
  epfEmployer  Float     @default(0)        // 12% of basic
  etfEmployer  Float     @default(0)        // 3% of basic
  employerCost Float     @default(0)        // gross + epfEmployer + etfEmployer
  status       String    @default("Pending") // Pending | Paid
  method       String    @default("Cash")    // Cash | Bank | Cheque
  paidDate     DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacher      Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, month])
}

// ─── Classes / Tuition sessions ───────────────────────────────────────────
model Class {
  id          String   @id @default(cuid())
  name        String
  programId   String?
  teacherId   String?
  dayOfWeek   String?                       // Mon..Sun
  startTime   String?                       // "08:30"
  endTime     String?                       // "10:30"
  room        String?
  capacity    Int      @default(20)
  fee         Float    @default(0)
  instituteSharePct Float @default(25)   // % of class fee that goes to the institute
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program     Program? @relation(fields: [programId], references: [id])
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
}

// ─── Enrollment (student <-> program, student <-> class) ──────────────────
model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  programId  String?
  classId    String?
  enrolledAt DateTime @default(now())
  status     String   @default("Active")    // Active | Withdrawn
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program    Program? @relation(fields: [programId], references: [id])
  class      Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
}

// ─── Attendance (students via barcode, teachers via fingerprint) ──────────
model Attendance {
  id          String   @id @default(cuid())
  personType  String                          // Student | Teacher
  personId    String                          // student.id or teacher.id
  personRef   String                          // studentId / teacherId (denormalized for quick read)
  date        DateTime @default(now())        // date of record
  checkIn     DateTime?
  checkOut    DateTime?
  method      String   @default("Manual")     // Barcode | Fingerprint | Manual
  status      String   @default("Present")    // Present | Absent | Late | Leave
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student? @relation(fields: [personId], references: [id], onDelete: Cascade)
  teacher     Teacher? @relation(fields: [personId], references: [id], onDelete: Cascade)
}

// ─── School Settings ──────────────────────────────────────────────────────
model Setting {
  id    String @id
  key   String @unique
  value String
}

// ─── Payments (monthly tuition fee tracking) ──────────────────────────────
model Payment {
  id          String   @id @default(cuid())
  studentId   String
  programId   String?
  classId     String?
  month       String                       // "2025-01" (YYYY-MM) the fee is FOR
  amount      Float                        // amount charged
  paidAmount  Float    @default(0)         // amount actually paid
  method      String   @default("Cash")    // Cash | Card | Bank | Online
  status      String   @default("Pending") // Pending | Partial | Paid | Overdue
  paidDate    DateTime?
  dueDate     DateTime?
  note        String?
  receiptNo   String?  @unique             // auto-generated e.g. SAN-2025-0001
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program     Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  items       PaymentItem[]
}

// ─── PaymentItem (one bill line per programme) ─────────────────────────────
// A single Payment bill can contain SEVERAL programmes for the same student —
// the student name appears once and each programme is a line item.
model PaymentItem {
  id          String   @id @default(cuid())
  paymentId   String
  programId   String?
  description String?                       // optional label override
  amount      Float    @default(0)          // amount charged for this line
  createdAt   DateTime @default(now())

  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  program     Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
}

// ─── Expenses (institute operating expenses & outgoings) ──────────────────
// Salaries are handled by Payroll (PayrollRecord) — this tracks everything
// else the institute spends: rent, utilities, supplies, transport, etc.
model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String
  description String
  amount      Float
  method      String   @default("Cash")    // Cash | Bank | Card
  vendor      String?
  note        String?
  // Approval lifecycle: entries flagged "Pending" await an owner review;
  // Rejected rows are voided and excluded from every financial aggregate.
  // Legacy rows (and recurring-template/bulk-created rows) default Approved.
  status      String   @default("Approved") // Pending | Approved | Rejected
  reviewedAt  DateTime?                     // when Approved/Rejected was set
  reviewedBy  String?                       // reviewer label (no auth system)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Announcements / Notices (admin broadcast to staff & parents) ─────────
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  category    String   @default("General")   // General | Event | Holiday | Urgent | Payment | Meeting
  audience    String   @default("All")        // All | Staff | Parents | Teachers
  priority    String   @default("Normal")     // Low | Normal | High
  pinned      Boolean  @default(false)
  status      String   @default("Published")  // Draft | Published | Archived
  publishDate DateTime @default(now())
  expiryDate  DateTime?
  authorName  String?                          // admin who posted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

